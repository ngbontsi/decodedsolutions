# Family-tree beta image: React UI bundled into the Spring Boot jar, one port.
# Build from the repository root:
#   docker build -f Dockerfile.family-tree -t family-tree .

FROM node:20-alpine AS ui
WORKDIR /ui
COPY frontend/family-tree/package.json frontend/family-tree/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/family-tree/ ./
RUN npm run build

FROM maven:3-eclipse-temurin-21-alpine AS api
WORKDIR /app
COPY backend/family-tree-service/pom.xml ./
COPY backend/family-tree-service/src ./src
COPY --from=ui /ui/dist ./src/main/resources/static
RUN mvn -B -q clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=api /app/target/family-tree-service-1.0.0.jar app.jar
USER app
EXPOSE 8085
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["java", "-jar", "app.jar"]
