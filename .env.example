# =============================================================================
# Decoded Solutions Platform - Local Development Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Generate a strong random value (>= 32 chars), e.g.:
#   openssl rand -base64 48
#   # or: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Local dev uses a single Postgres instance with 5 databases, each owned by
# a separate role (auth_app, restaurant_app, guesthouse_app, marketplace_app, familytree_app).
# The superuser (DB_USERNAME/DB_PASSWORD) is used by the database-provisioner
# to create roles/databases. Services connect as their respective _app roles.
DB_USERNAME=platformuser
DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Internal Service-to-Service Communication
# -----------------------------------------------------------------------------
# Shared secret for gateway -> service authentication.
# Generate: openssl rand -base64 32
INTERNAL_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Family Tree Service (Beta)
# -----------------------------------------------------------------------------
# Optional passcode for private beta access. Leave empty to disable.
BETA_PASSCODE=

# -----------------------------------------------------------------------------
# Frontend API URLs (for local development)
# -----------------------------------------------------------------------------
# These are used by frontend apps to know where the backend API is.
# For local dev with docker-compose, the gateway is at localhost:8080
VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Redis (Token Blacklist)
# -----------------------------------------------------------------------------
# No auth for local dev; configure if needed for prod parity
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Quick Start:
#   1. cp .env.example .env
#   2. Fill in JWT_SECRET and INTERNAL_SHARED_SECRET (generate with openssl)
#   3. Set DB_PASSWORD to a strong password
#   4. Run: .\start-containers.ps1
# =============================================================================